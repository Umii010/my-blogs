<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <style>
        /* Import Oxygen font from Google Fonts */
        @import url('https://fonts.googleapis.com/css2?family=Oxygen&display=swap');

        body {
            font-family: 'Oxygen', sans-serif;
            line-height: 1.6;
            letter-spacing: 0.5px;
            font-style: normal;
            margin: 0;
            padding: 0;
            background-color: #f4f7f6;
            color: #333;
        }
        code {
            color: white !important;
        }

        .comment-section {
            padding-top: 20px;
        }

        .comment-section h3 {
            border-bottom: 3px solid rgb(126, 34, 206);
            font-size: 1.5rem;
            color: #0B3749;
            padding-bottom: 5px;
            margin-bottom: 20px;
        }

        .comment-box {
            width: 200%;
            padding: 10px;
            font-size: 1rem;
            border: 1px solid #ddd;
            border-radius: 5px;
            margin-bottom: 10px;
            transition: border-color 0.3s ease-in-out;
        }
        .comment-box:focus {
            border-color: rgb(126, 34, 206);
            outline: none;
            box-shadow: 0 0 5px rgba(126, 34, 206, 0.5);
        }

        .submit-comment {
            background-color: #7c24cc;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 1rem;
            cursor: pointer;
            border-radius: 5px;
            transition: background-color 0.3s ease;
        }

        .submit-comment:hover {
            background-color: rgb(126, 34, 206);
        }

        .comments-list {
            margin-top: 20px;
        }

        .comment {
            background-color: #f9f9f9;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 5px;
            margin-bottom: 10px;
        }

        .comment .author {
            font-weight: bold;
            color: #0B3749;
        }

        .comment .timestamp {
            font-size: 0.9rem;
            color: #777;
        }

        .comment .text {
            margin-top: 5px;
        }

        /* Container Styling */
        .container {
            max-width: 900px;
            margin: 50px auto;
            padding: 30px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1), 0 8px 12px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
            background-color: #fff;
        }

        .install-laravel {
            color: rgb(126, 34, 206);
            font-weight: 600;
            text-align: center;
            font-size: 2.5rem;
            line-height: 130%;
            letter-spacing: 0.5px;
            margin-bottom: 0px;
        }

        /* Author Information */
        .author-info {
            text-align: center;
            margin: 20px 0;
            border-bottom: 2px solid #f4f4f4;
            padding-bottom: 20px;
        }

        .author-info img {
            width: 90px;
            height: 95px;
            border-radius: 50%;
            transition: transform 0.3s ease;
        }

        .author-info img:hover {
            transform: scale(1.1);
        }

        h2 {
            color: #0B3749;
            font-weight: bold;
            margin-top: 30px;
            border-bottom: 3px solid rgb(126, 34, 206);
            padding-bottom: 2px;
        }

        /* Link Styles */
        a {
            color: #05e0c0;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.3s ease;
        }

        a:hover {
            color: rgb(126, 34, 206);
            text-decoration: underline;
        }

        .code-container {
            background-color: #333;
            color: #fff;
            padding: 15px;
            border-radius: 5px;
            overflow-x: auto;
            margin: 20px 0;
            font-family: 'Courier New', monospace;
            font-size: 1rem;
            position: relative;
        }

        .copy-btn {
            position: absolute;
            right: 10px;
            background-color: #05e0c0;
            color: #fff;
            border: none;
            padding: 5px 10px;
            font-size: 16px;
            cursor: pointer;
            transition: background-color 0.3s ease;
            top: 10px;
        }

        .copy-btn:hover {
            background-color: rgb(126, 34, 206);
        }

        .umer-shahzad {
            font-size: 38px;
            line-height: 130%;
            letter-spacing: 0.5px;
            font-weight: 200;
            margin: 0px;
        }
